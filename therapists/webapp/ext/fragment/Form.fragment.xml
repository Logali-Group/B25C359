<core:FragmentDefinition
                xmlns="sap.m"
                xmlns:core="sap.ui.core">

        <Dialog id="dialog">

            <content>
            
            
            </content>


            <beginButton>
                <Button
                        id="save"
                        text="{i18n>save}"
                        tooltip="{i18n>save}"
                        type="Emphasized"
                        press="onCreatePress"
                        width="4rem"/>
            </beginButton>

            <endButton>
                <Button
                        id="cancel"
                        text="{i18n>cancel}"
                        tooltip="{i18n>cancel}"
                        type="Reject"
                        press="onClosePress"
                        width="4rem"/>
            </endButton>
        
        </Dialog>


</core:FragmentDefinition>