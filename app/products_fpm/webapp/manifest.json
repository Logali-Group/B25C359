{
  "_version": "1.65.0",
  "sap.app": {
    "id": "productsfpm",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:fpm",
      "version": "1.18.3",
      "toolsId": "e806762c-6edc-47b1-bec0-a8f3ac9608d5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/product-srv/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.133.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "productsfpm.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "name": "ProductsMain",
          "pattern": ":?query:",
          "target": "ProductsMain"
        },
        {
          "name": "ProductsDetailsPage",
          "pattern": "Products({ProductsKey}):?query:",
          "target": "ProductsDetailsPage"
        }
      ],
      "targets": {
        "ProductsMain": {
          "type": "Component",
          "id": "ProductsMain",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {
                "Products": {
                  "detail": {
                    "route": "ProductsDetailsPage"
                  }
                }
              },
              "contextPath": "/Products",
              "viewName": "productsfpm.ext.main.Main"
            }
          }
        },
        "ProductsDetailsPage": {
          "type": "Component",
          "id": "ProductsDetailsPage",
          "name": "sap.fe.core.fpm",
          "options": {
            "settings": {
              "navigation": {},
              "contextPath": "/Products",
              "viewName": "productsfpm.ext.view.Details"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {}
}
