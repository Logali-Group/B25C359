<mvc:View 
        controllerName="productsfpm.ext.view.Details"
        xmlns="sap.m" 
        xmlns:uxap="sap.uxap"
        xmlns:core="sap.ui.core" 
        xmlns:mvc="sap.ui.core.mvc" 
        xmlns:macros="sap.fe.macros">


        <uxap:ObjectPageLayout>
        
            <uxap:headerTitle>

                <uxap:ObjectPageDynamicHeaderTitle>

                    <uxap:expandedHeading>
                        <Title text="{product}"/>
                    </uxap:expandedHeading>


                    <uxap:expandedContent>
                        <Text text="{productName}"/>
                    </uxap:expandedContent>
                
                </uxap:ObjectPageDynamicHeaderTitle>
            
            </uxap:headerTitle>


            <uxap:sections>

                <uxap:ObjectPageSection title="{i18n>ProductInformation}">
                    
                    <uxap:subSections>

                        <uxap:ObjectPageSubSection>

                            <uxap:blocks>

                                <macros:Form id="FieldGroupProductInformation"
                                            metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#ProductInformation"/>

                            </uxap:blocks>
                        
                        </uxap:ObjectPageSubSection>
                    
                    </uxap:subSections>
                
                </uxap:ObjectPageSection>
            
            </uxap:sections>
        
        </uxap:ObjectPageLayout>

</mvc:View>