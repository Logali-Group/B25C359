{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start therapists",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/therapists",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "fiori",
                "run"
            ],
            "args": [
                "--open",
                "test/flp.html#app-preview"
            ],
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "outputCapture": "std",
            "env": {
                "DEBUG": "--inspect",
                "FIORI_TOOLS_URL_PARAMS": "sap-ui-xx-viewCache=false",
                "run.config": "{\"handlerId\":\"fiori_tools\",\"runnableId\":\"/home/user/projects/therapists/therapists\"}"
            }
        }
    ]
}